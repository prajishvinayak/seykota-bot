# ---------------------------------------------------------------------------
# Capital.com API credentials — TEMPLATE.
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#
# How to get these (do it on your DEMO account first):
#   Capital.com web/app  ->  Settings  ->  API integrations  ->  Generate API key
#   You set a custom PASSWORD when generating the key — that is CAPITAL_API_PASSWORD,
#   NOT your normal login password.
#   CAPITAL_IDENTIFIER is your Capital.com login email.
# ---------------------------------------------------------------------------

# demo | live   — KEEP THIS ON "demo" until the bot is forward-tested for weeks.
CAPITAL_ENVIRONMENT=demo

# The API key string shown when you generate the key
CAPITAL_API_KEY=

# Your Capital.com account login email
CAPITAL_IDENTIFIER=

# The custom password you typed when creating the API key (NOT your login password)
CAPITAL_API_PASSWORD=

# --- Endpoints (defaults are correct; only change if Capital.com updates them) ---
CAPITAL_BASE_URL_DEMO=https://demo-api-capital.backend-capital.com
CAPITAL_BASE_URL_LIVE=https://api-capital.backend-capital.com
CAPITAL_WS_URL=wss://api-streaming-capital.backend-capital.com/connect
